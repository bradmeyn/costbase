		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.5",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",

		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.0.12",
		"vitest": "^5.0.0"
	},
	"type": "module",
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"better-auth": "~1.3.27",
		"drizzle-orm": "^0.45.2",
		"layerchart": "^2.5.0",
